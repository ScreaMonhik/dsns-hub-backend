<file path="prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum AuditAction {
  UPDATED
  DELETED
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
}

enum AuditLogResource {
  USER
  NEWS
  PROJECT
  DOCUMENT
  POLL
  DEPARTMENT
  CHAT
  EMERGENCY_BROADCAST
}

enum BroadcastSeverity {
  INFO
  WARNING
  CRITICAL
}

enum BroadcastSound {
  DEFAULT
  SIREN
  ALERT
}

enum BroadcastStatus {
  SENT
  FAILED
  PENDING
}

enum BannerSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NewsStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum PollStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model NewsCategory {
  id         String @id @default(uuid())
  name       String @unique
  orderIndex Int    @default(0)
  news       News[]
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                Role     @default(USER)
  avatarUrl           String?
  isActive            Boolean  @default(true)
  failedLoginAttempts Int      @default(0)
  forcePasswordChange Boolean  @default(false)
  createdAt           DateTime @default(now())

  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Зв'язки
  news            News[]
  newsComments    NewsComment[]
  newsVotes       NewsVote[]
  projects        Project[]
  projectComms    ProjectComment[]
  projectVotes    ProjectVote[]
  messages        ChatMessage[]
  auditLogs       MessagesAuditLog[]
  polls           Poll[]
  pollVotes       PollVote[]
  chatGroups      GroupMember[]
  readMessages    MessageReadReceipt[]
  documents       Document[]
  systemAuditLogs SystemAuditLog[]
  apiAuditLogs    ApiAuditLog[]
  auditLogsRef    AuditLog[]
  emergencyBroadcasts EmergencyBroadcast[]
  sessions        UserSession[]

  @@index([departmentId])
}

model UserSession {
  id           String   @id @default(uuid())
  refreshToken String   @db.Text
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String           @id @default(uuid())
  action    AuditLogAction
  resource  AuditLogResource
  details   Json?
  ipAddress String?
  createdAt DateTime         @default(now())

  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, resource, createdAt])
  @@index([userId])
}

model SystemAuditLog {
  id          String   @id @default(uuid())
  entityName  String
  entityId    String
  action      String   // CREATE, UPDATE, DELETE
  oldValues   Json?
  newValues   Json?
  createdAt   DateTime @default(now())

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ApiAuditLog {
  id          String   @id @default(uuid())
  method      String
  url         String
  payload     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Department {
  id         String      @id @default(uuid())
  name       String
  parentId   String?
  orderIndex Int         @default(0)
  parent     Department? @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Department[] @relation("DepartmentTree")

  users      User[]
  documents  Document[]
  polls      Poll[]
  chatGroups ChatGroup[]
  news       News[]
  projects   Project[]
  emergencyBroadcasts EmergencyBroadcast[]

  @@index([parentId])
}

model News {
  id           String        @id @default(uuid())
  title        String
  content      String        @db.Text
  imageUrl     String?
  status         NewsStatus    @default(PUBLISHED)
  publishedAt    DateTime?
  upvotesCount   Int           @default(0)
  downvotesCount Int           @default(0)
  categoryId     String?
  category       NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  departments  Department[]
  createdAt    DateTime      @default(now())

  authorId     String
  author       User          @relation(fields: [authorId], references: [id])

  comments     NewsComment[]
  votes        NewsVote[]

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([authorId])
}

model NewsComment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId, createdAt])
}

model NewsVote {
  voteType  VoteType
  createdAt DateTime @default(now())
  userId    String
  newsId    String
  user      User     @relation(fields: [userId], references: [id])
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@id([userId, newsId])
}

model Document {
  id          String         @id @default(uuid())
  title       String
  description String?        @db.Text
  fileUrl     String
  status      DocumentStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  authorId    String?
  author      User?          @relation(fields: [authorId], references: [id])

  departments Department[]

  @@index([status, createdAt])
  @@index([authorId])
}

model Project {
  id          String        @id @default(uuid())
  title       String
  description String        @db.Text
  fileUrl     String
  status         ProjectStatus @default(DRAFT)
  upvotesCount   Int           @default(0)
  downvotesCount Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  authorId    String
  author      User          @relation(fields: [authorId], references: [id])

  departments Department[]
  comments    ProjectComment[]
  votes       ProjectVote[]

  @@index([status, createdAt])
  @@index([authorId])
}

model ProjectComment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectVote {
  voteType  VoteType
  createdAt DateTime @default(now())
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model ChatGroup {
  id           String      @id @default(uuid())
  name         String
  avatarUrl    String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  members  GroupMember[]
  messages ChatMessage[]
}

model GroupMember {
  userId   String
  groupId  String
  isAdmin  Boolean   @default(false)
  isPinned Boolean   @default(false)
  pinOrder Int?      // Зберігає індекс послідовності закріплених чатів
  joinedAt DateTime  @default(now())
  user     User      @relation(fields: [userId], references: [id])
  group    ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  content   String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  groupId String
  group   ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  readReceipts MessageReadReceipt[]

  @@index([groupId, createdAt])
}

model MessageReadReceipt {
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model MessagesAuditLog {
  id         String      @id @default(uuid())
  messageId  String
  oldContent String
  action     AuditAction
  changedAt  DateTime    @default(now())

  userId    String
  changedBy User   @relation(fields: [userId], references: [id])
}

model Poll {
  id                   String     @id @default(uuid())
  title                String
  description          String?    @db.Text
  status               PollStatus @default(PUBLISHED)
  expiresAt            DateTime?
  archivedVisibleUntil DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  authorId     String?
  author       User?      @relation(fields: [authorId], references: [id])

  departments  Department[]
  
  options      PollOption[]

  @@index([status, createdAt])
  @@index([authorId])
}

model PollOption {
  id         String @id @default(uuid())
  text       String
  orderIndex Int    @default(0)

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  votes PollVote[]
}

model PollVote {
  createdAt DateTime   @default(now())
  userId    String
  optionId  String
  user      User       @relation(fields: [userId], references: [id])
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([userId, optionId])
}

model EmergencyBroadcast {
  id             String            @id @default(uuid())
  title          String
  body           String            @db.Text
  severity       BroadcastSeverity @default(INFO)
  soundPreset    BroadcastSound    @default(DEFAULT)
  status         BroadcastStatus   @default(PENDING)
  recipientCount Int               @default(0)
  createdAt      DateTime          @default(now())

  authorId       String
  author         User              @relation(fields: [authorId], references: [id])

  departments    Department[]

  @@index([severity, createdAt])
  @@index([authorId])
}

model SystemSetting {
  id                   String         @id @default("global")
  maintenanceMode      Boolean        @default(false)
  maintenanceMessage   String?        @db.Text
  globalBannerEnabled  Boolean        @default(false)
  globalBannerText     String?        @db.Text
  globalBannerSeverity BannerSeverity @default(INFO)
  maxPdfSizeMB         Int            @default(20)
  maxMediaSizeMB       Int            @default(100)
  updatedAt            DateTime       @updatedAt
}
