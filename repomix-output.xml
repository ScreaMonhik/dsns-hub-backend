  @ApiProperty({ description: 'HTML-строка контенту новини', example: '<p>Текст новини...</p>' })
  @IsString()
  @IsNotEmpty()
  content!: string;

  @ApiPropertyOptional({ description: 'URL головного зображення', example: '/news/media/file.jpg' })
